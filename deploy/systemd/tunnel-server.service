[Unit]
Description=Rust Tunnel Server (public QUIC + HTTP/TCP/UDP ingress)
Documentation=https://github.com/example/RSTunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tunnel
Group=tunnel
ExecStart=/usr/local/bin/tunnel-server --config /etc/tunnel/server.toml
Restart=always
RestartSec=5

# ---- 沙箱（§49）----
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
PrivateDevices=true

# SQLite 可写状态目录（systemd 会按 User/Group 创建并授权）
StateDirectory=tunnel-server

# 非 root 绑定 443/tcp 与 443/udp（§48：不要默认 root）
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
