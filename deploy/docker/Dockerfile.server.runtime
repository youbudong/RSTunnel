# syntax=docker/dockerfile:1

# ---- runtime-only（arm64 组装用）------------------------------------------
# 与 Dockerfile.server 的 runtime 阶段一致，但不在此编译 Rust：二进制由 CI
# `binaries-aarch64` job 用 `cross` 原生交叉编译产出，web 静态资源由 `web` job
# 产出，经 build-context（`./ctx`）注入。这样 arm64 镜像无需在 QEMU 仿真下编译。
FROM debian:bookworm-slim

# ca-certificates：HTTP 客户端/系统根；libsqlite3-0：SQLx 运行时依赖；passwd：建非 root 用户。
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libsqlite3-0 passwd \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 65532 tunnel \
    && useradd -u 65532 -g tunnel -s /usr/sbin/nologin -d /data tunnel \
    && mkdir -p /data /etc/tunnel/certs \
    && chown -R 65532:65532 /data /etc/tunnel/certs

COPY tunnel-server /usr/local/bin/tunnel-server
COPY dist /app/web/dist

VOLUME ["/data"]
USER 65532:65532

ENTRYPOINT ["tunnel-server"]
CMD ["--config", "/etc/tunnel/server.toml"]
