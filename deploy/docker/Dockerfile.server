# syntax=docker/dockerfile:1

# ---- build stage ----------------------------------------------------------
# Cargo.lock 为 v4，需 Cargo >= 1.83；rust-version = 1.88。用 1.88 stable 构建。
FROM rust:1.88-slim-bookworm AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libsqlite3-dev curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# 复制整个 workspace 源码（含 path 依赖与编译期内嵌的 migrations）。
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY server ./server
COPY agent ./agent
COPY migrations ./migrations

# 缓存挂载：cargo registry + target 跨发布复用，依赖只编译一次（T-45/§125 构建提速）。
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/build/target \
    cargo build --release -p tunnel-server \
    && cp /build/target/release/tunnel-server /build/tunnel-server

# ---- web build stage ------------------------------------------------------
# Web 管理后台（T-24）：构建 `web/dist`，由 runtime 阶段 COPY 进 server 镜像，
# server 经 `[internal].web_dir` 同源托管（无需另跑 vite）。
FROM node:20-bookworm-slim AS web

WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./
RUN npm run build

# ---- runtime stage --------------------------------------------------------
FROM debian:bookworm-slim

# ca-certificates：HTTP 客户端/系统根（T-30 接入）；libsqlite3-0：SQLx 运行时依赖。
# passwd：提供 useradd/groupadd，创建非 root 用户（§126：不要默认 root）。
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libsqlite3-0 passwd \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 65532 tunnel \
    && useradd -u 65532 -g tunnel -s /usr/sbin/nologin -d /data tunnel \
    && mkdir -p /data /etc/tunnel/certs \
    && chown -R 65532:65532 /data /etc/tunnel/certs

COPY --from=build /build/tunnel-server /usr/local/bin/tunnel-server
COPY --from=web /web/dist /app/web/dist

VOLUME ["/data"]
USER 65532:65532

ENTRYPOINT ["tunnel-server"]
CMD ["--config", "/etc/tunnel/server.toml"]
